# Metered TURN — get your key at https://www.metered.ca
# This key stays SERVER-SIDE only. Never put it in public JS.
TURN_API_KEY=your_metered_api_key_here

# Optional: static TURN fallback (only if you have your own TURN server)
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USER=your-turn-username
# TURN_PASS=your-turn-password

# PORT is set automatically by Railway — do not set it manually there
# PORT=3000
